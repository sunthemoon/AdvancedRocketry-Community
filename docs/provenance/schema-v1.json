{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sunthemoon/AdvancedRocketry-Community/blob/main/docs/provenance/schema-v1.json",
  "title": "Advanced Rocketry Community provenance batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "target_version", "source_repository", "source_branch", "source_commit", "license", "copyright_notice", "entries", "review"],
  "properties": {
    "schema_version": {"const": 1},
    "batch_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "target_version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source_repository": {"type": "string", "format": "uri"},
    "source_branch": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "license": {"type": "string", "minLength": 1},
    "copyright_notice": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_path", "status", "source_repository", "source_branch", "source_commit", "source_path", "source_sha256", "target_sha256", "license", "copyright_notice", "transformation"],
        "properties": {
          "target_path": {"type": "string", "minLength": 1},
          "status": {"enum": ["NEW", "UPSTREAM_AR_MIT", "THIRD_PARTY_APPROVED", "GENERATED", "QUARANTINED", "REJECTED"]},
          "source_repository": {"type": "string", "format": "uri"},
          "source_branch": {"type": "string", "minLength": 1},
          "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "source_path": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "target_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "license": {"type": "string", "minLength": 1},
          "copyright_notice": {"type": "string", "minLength": 1},
          "transformation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "content_digest", "reviewer", "reviewed_at", "findings"],
      "properties": {
        "status": {"enum": ["PENDING_HUMAN_REVIEW", "APPROVED", "CHANGES_REQUIRED"]},
        "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reviewer": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"]},
        "findings": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
