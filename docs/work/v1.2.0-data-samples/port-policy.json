      "kind": "ITEM",
      "mode": "INPUT",
      "local_sides": ["TOP"],
      "range": {"first": 0, "count": 1}
    },
    {
      "channel": "fluid_input",
      "kind": "FLUID",
      "mode": "INPUT",
      "local_sides": ["LEFT"],
      "range": {"first": 0, "count": 1}
    },
    {
      "channel": "energy_input",
      "kind": "ENERGY",
      "mode": "INPUT",
      "local_sides": ["BACK"],
      "range": {"first": 0, "count": 1}
    },
    {
      "channel": "item_output",
      "kind": "ITEM",
      "mode": "OUTPUT",
      "local_sides": ["BOTTOM"],
      "range": {"first": 1, "count": 2}
    }
  ]
}
