CODE 3f3d62aed3980186fe0acc9592cf93ca436405fb src/main/java/io/github/sunthemoon/advancedrocketrycommunity/persistence/ChunkSaveDenials.java {'bytes': 1856, 'sha256': '96a66b34e46af0ae079802263e46b595eba83cae0ce179a22176165c49e15427'}
1: package io.github.sunthemoon.advancedrocketrycommunity.persistence;
2: 
3: import java.util.HashMap;
4: import java.util.Map;
5: import java.util.Optional;
6: 
7: /** Transient refusal identities, never inventories; retained until the Level ends. */
8: public final class ChunkSaveDenials {
9:     public static final int MAX_CHUNKS = 256;
10:     public static final int MAX_REASON_CHARS = 256;
11:     private static final String SATURATED = "Refusing chunk save after denial capacity exhausted; back up and repair first";
12:     private static final String CLOSED = "Refusing chunk save after guard lifecycle ended";
13:     private final Map<Long, String> reasons = new HashMap<>();
14:     private boolean saturated;
15:     private boolean closed;
16: 
17:     public synchronized void deny(long chunk, String reason) {
18:         if (reason == null || reason.isBlank() || reason.length() > MAX_REASON_CHARS) {
19:             throw new IllegalArgumentException("Invalid bounded chunk-save refusal reason");
20:         }
21:         if (closed || reasons.containsKey(chunk)) { return; }
22:         if (reasons.size() == MAX_CHUNKS) { saturated = true; return; }
23:         reasons.put(chunk, reason);
24:     }
25: 
26:     public synchronized Optional<String> reason(long chunk) {
27:         if (closed) { return Optional.of(CLOSED); }
28:         String reason = reasons.get(chunk);
29:         return reason != null ? Optional.of(reason) : saturated ? Optional.of(SATURATED) : Optional.empty();
30:     }
31: 
32:     public synchronized int size() { return reasons.size(); }
33:     public synchronized void close() { closed = true; reasons.clear(); }
34: 
35:     // Only the Forge bridge's actual GameTestServer cleanup uses this, never ordinary save/unload.
36:     synchronized void restoreFixture(long chunk) {
37:         if (closed || saturated) { throw new IllegalStateException("Cannot reset closed or saturated save guard"); }
38:         reasons.remove(chunk);
39:     }
40: }

