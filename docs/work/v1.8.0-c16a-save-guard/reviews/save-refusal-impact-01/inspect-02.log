13: /** Independent schema 1 shared verbatim between a tank BE and its dropped Item. */
14: public final class TankSave {
15:     public static final String ROOT = "arce_pressurized_tank";
16:     public static final int MAX_BYTES = 8_192;
17:     private static final Set<String> KEYS = Set.of("schema", "fluid");
18:     private static final Set<String> FLUID_KEYS = Set.of("FluidName", "Amount", "Tag");
19: 
20:     public static boolean bounded(Tag tag) { return BoundedNbt.fits(tag, MAX_BYTES, 16, 1_024); }
21: 
22:     public static boolean safe(FluidStack fluid) {
23:         if (fluid.isEmpty()) {
24:             return true;
25:         }
26:         if (fluid.getAmount() <= 0 || (fluid.hasTag() && !bounded(fluid.getTag()))) {
27:             return false;
28:         }
29:         ResourceLocation id = ForgeRegistries.FLUIDS.getKey(fluid.getFluid());
30:         return id != null && id.toString().length() <= ProcessResourceKey.MAX_RESOURCE_ID_CHARS
31:                 && ForgeRegistries.FLUIDS.containsKey(id) && fluid.getFluid() != Fluids.EMPTY
32:                 && bounded(fluid.writeToNBT(new CompoundTag()));
33:     }
34: 
35:     public static CompoundTag encode(FluidStack fluid) {
36:         if (!safe(fluid)) {
37:             throw new IllegalArgumentException("Fluid payload exceeds tank limits");
38:         }
39:         CompoundTag root = new CompoundTag();
40:         root.putInt("schema", 1);
41:         root.put("fluid", fluid.isEmpty() ? new CompoundTag() : fluid.writeToNBT(new CompoundTag()));
42:         if (!bounded(root)) {
43:             throw new IllegalArgumentException("Tank root exceeds aggregate budget");
44:         }
45:         // Forge's fluid writer retains the input Tag reference; copy only after aggregate preflight.
46:         return root.copy();
47:     }
48: 
49:     public static boolean fits(FluidStack fluid) {
50:         try { encode(fluid); return true; }
51:         catch (IllegalArgumentException refused) { return false; }
52:     }
53: 
54:     public static FluidStack decode(Tag raw) {
55:         if (!bounded(raw) || !(raw instanceof CompoundTag root) || !root.getAllKeys().equals(KEYS)
56:                 || !root.contains("schema", Tag.TAG_INT) || root.getInt("schema") != 1
57:                 || !root.contains("fluid", Tag.TAG_COMPOUND)) {
58:             throw new IllegalArgumentException("Unsupported tank root");
59:         }
60:         CompoundTag encoded = root.getCompound("fluid");
61:         if (encoded.isEmpty()) {
62:             return FluidStack.EMPTY;
63:         }
64:         if (!FLUID_KEYS.containsAll(encoded.getAllKeys()) || !encoded.contains("FluidName", Tag.TAG_STRING)
66:                 || (encoded.contains("Tag") && !encoded.contains("Tag", Tag.TAG_COMPOUND))) {
67:             throw new IllegalArgumentException("Invalid fluid envelope");
68:         }
69:         String name = encoded.getString("FluidName");
70:         ResourceLocation id = name.length() <= ProcessResourceKey.MAX_RESOURCE_ID_CHARS
71:                 ? ResourceLocation.tryParse(name) : null;
72:         if (id == null || !ForgeRegistries.FLUIDS.containsKey(id)
73:                 || ForgeRegistries.FLUIDS.getValue(id) == Fluids.EMPTY) {
74:             throw new IllegalArgumentException("Unknown or empty fluid identity");
75:         }
76:         FluidStack fluid = FluidStack.loadFluidStackFromNBT(encoded);
77:         if (!safe(fluid) || fluid.isEmpty() || !fluid.writeToNBT(new CompoundTag()).equals(encoded)) {
78:             throw new IllegalArgumentException("Tank fluid cannot be decoded losslessly");
79:         }

