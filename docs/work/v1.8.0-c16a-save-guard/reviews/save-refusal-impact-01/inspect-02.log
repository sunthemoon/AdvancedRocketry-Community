18: /** Refuse removal and veto oversized saves without asking LevelChunk to omit a BlockEntity. */
19: @Mod.EventBusSubscriber(modid = AdvancedRocketryCommunity.MOD_ID)
20: public final class RecipeSignatureProtection {
21:     private static final Set<String> CONTROLLER_IDS = Set.of(
22:             "advancedrocketrycommunity:rolling_machine",
23:             "advancedrocketrycommunity:precision_assembler",
24:             "advancedrocketrycommunity:electrolyzer");
25: 
26:     @SubscribeEvent
27:     public static void breaking(BlockEvent.BreakEvent event) {
28:         if (blocksRemoval(event.getLevel(), event.getPos())) { event.setCanceled(true); }
29:     }
30: 
31:     @SubscribeEvent
32:     public static void entityDestruction(LivingDestroyBlockEvent event) {
33:         if (blocksRemoval(event.getEntity().level(), event.getPos())) { event.setCanceled(true); }
34:     }
35: 
36:     @SubscribeEvent
37:     public static void explosion(ExplosionEvent.Detonate event) {
38:         event.getAffectedBlocks().removeIf(position -> blocksRemoval(event.getLevel(), position));
39:     }
40: 
41:     @SubscribeEvent
42:     public static void chunkSave(ChunkDataEvent.Save event) {
43:         GuardedChunkSaves.beforeSave(event);
44:         try {
45:             requireBoundedChunk(event.getData(), 256 * event.getChunk().getHeight(), () -> { });
46:         } catch (IllegalStateException refused) {
47:             // Persist the transient denial before ChunkMap can clear the live BlockEntity list.
48:             GuardedChunkSaves.refuse(event, refused.getMessage());
49:         }
50:     }
51: 
52:     static void requireBoundedChunk(CompoundTag data, int maximumEntities, Runnable retainRetry) {
53:         var entities = data.getList("block_entities", Tag.TAG_COMPOUND);
54:         if (entities.size() > maximumEntities) {
55:             retainRetry.run();
56:             throw new IllegalStateException("Chunk block-entity count exceeds its physical bound");
57:         }
58:         for (int index = 0; index < entities.size(); index++) {
59:             CompoundTag entity = entities.getCompound(index);
60:             if (CONTROLLER_IDS.contains(entity.getString("id")) && !RecipeSignatureMigration.bounded(entity)) {
61:                 retainRetry.run();
62:                 throw new IllegalStateException("Refusing chunk save with oversized recipe input; back up and repair first");
63:             }
64:         }
65:     }
66: 
67:     /** Shared by Forge entity hooks and events; never load a missing chunk. */
68:     public static boolean blocksRemoval(BlockGetter level, BlockPos position) {
69:         return level instanceof ServerLevel server && server.hasChunkAt(position)
70:                 && server.getBlockEntity(position) instanceof RecipeSignatureProtected guarded
71:                 && guarded.preservesRecipeInput();
72:     }
73: 
74:     private RecipeSignatureProtection() { }
75: }

