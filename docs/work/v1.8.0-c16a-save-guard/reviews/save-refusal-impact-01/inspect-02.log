22:     public static boolean bounded(Tag raw) { return BoundedNbt.fits(raw, MAX_BYTES, 16, 1_024); }
23:     public static CompoundTag encode(UUID owner, int energy, int cooldown, FluidStack fluid) {
24:         new PumpBudget.State(energy, fluid.getAmount(), cooldown);
25:         if (fluid.hasTag() && !bounded(fluid.getTag())) {
26:             throw new IllegalArgumentException("Pump fluid tag exceeds budget");
27:         }
28:         CompoundTag payload = new CompoundTag();
29:         if (!fluid.isEmpty()) {
30:             ResourceLocation id = ForgeRegistries.FLUIDS.getKey(fluid.getFluid());
31:             if (id == null || id.toString().length() > ProcessResourceKey.MAX_RESOURCE_ID_CHARS
32:                     || !ForgeRegistries.FLUIDS.containsKey(id)) {
33:                 throw new IllegalArgumentException("Pump fluid identity exceeds limits or is unregistered");
34:             }
35:             payload = fluid.writeToNBT(new CompoundTag());
36:             if (!FLUID_KEYS.containsAll(payload.getAllKeys())
37:                     || !payload.contains("FluidName", Tag.TAG_STRING)
38:                     || !id.toString().equals(payload.getString("FluidName"))
39:                     || !payload.contains("Amount", Tag.TAG_INT) || payload.getInt("Amount") != fluid.getAmount()
40:                     || (payload.contains("Tag") && !payload.contains("Tag", Tag.TAG_COMPOUND))) {
41:                 throw new IllegalArgumentException("Pump fluid envelope is not lossless");
42:             }
43:         }
44:         if (!bounded(payload)) {
45:             throw new IllegalArgumentException("Pump fluid payload exceeds budget");
46:         }
47:         CompoundTag root = new CompoundTag();
48:         root.putInt("schema", 1);
49:         root.putInt("energy", energy);
50:         root.putInt("cooldown", cooldown);
51:         if (owner != null) { root.putUUID("owner", owner); }
52:         root.put("fluid", payload);
53:         if (!bounded(root)) { throw new IllegalArgumentException("Pump root exceeds aggregate budget"); }
54:         return root.copy();
55:     }
56:     public static boolean fits(UUID owner, int energy, int cooldown, FluidStack fluid) {
57:         try { encode(owner, energy, cooldown, fluid); return true; }
58:         catch (IllegalArgumentException refused) { return false; }
59:     }
