13: /** Strict independent schema 1; preflight before recursive copies or fluid decoding. */
14: public final class PumpSave {
15:     public static final String ROOT = "arce_pump";
16:     public static final int MAX_BYTES = 8_192;
17:     private static final Set<String> REQUIRED = Set.of("schema", "energy", "cooldown", "fluid");
18:     private static final Set<String> ALLOWED = Set.of("schema", "energy", "cooldown", "fluid", "owner");
19:     private static final Set<String> FLUID_KEYS = Set.of("FluidName", "Amount", "Tag");
20:     public record Snapshot(UUID owner, int energy, int cooldown, FluidStack fluid) { }
