22: 
23: /** Save refusal survives ChunkMap unload even when vanilla clears all live BlockEntities. */
24: @Mod.EventBusSubscriber(modid = ModIdentity.MOD_ID)
25: public final class GuardedChunkSaves {
26:     public static final Capability<ChunkSaveDenials> CAPABILITY = CapabilityManager.get(new CapabilityToken<>() { });
27: 
28:     @Mod.EventBusSubscriber(modid = ModIdentity.MOD_ID, bus = Mod.EventBusSubscriber.Bus.MOD)
29:     public static final class Registration {
30:         @SubscribeEvent public static void register(RegisterCapabilitiesEvent event) { event.register(ChunkSaveDenials.class); }
31:         private Registration() { }
32:     }
33: 
34:     @SubscribeEvent public static void attach(AttachCapabilitiesEvent<Level> event) {
35:         if (event.getObject() instanceof ServerLevel) {
36:             Provider provider = new Provider();
37:             event.addCapability(ModIdentity.id("guarded_chunk_saves"), provider);
38:             event.addListener(provider::invalidate);
39:         }
40:     }
41: 
42:     private static ChunkSaveDenials state(ServerLevel level) {
43:         return level.getCapability(CAPABILITY).orElseThrow(
44:                 () -> new IllegalStateException("Server Level chunk-save guard is unavailable"));
45:     }
46: 
47:     @SubscribeEvent(priority = EventPriority.HIGHEST)
48:     public static void beforeSave(ChunkDataEvent.Save event) {
49:         if (event.getLevel() instanceof ServerLevel level) {
50:             var reason = state(level).reason(event.getChunk().getPos().toLong());
51:             if (reason.isPresent()) { fail(event, reason.orElseThrow()); }
52:         }
53:     }
54: 
55:     public static void refuse(ChunkDataEvent.Save event, String reason) {
56:         if (event.getLevel() instanceof ServerLevel level) {
57:             state(level).deny(event.getChunk().getPos().toLong(), reason);
58:         }
59:         fail(event, reason);
60:     }
61: 
62:     private static void fail(ChunkDataEvent.Save event, String reason) {
63:         event.getChunk().setUnsaved(true);
64:         throw new IllegalStateException(reason);
65:     }
66: 
67:     /** Disposable GT fixtures only; a native DedicatedServer has no online guard-reset operation. */
68:     public static void restoreGameTestFixture(ServerLevel level, ChunkPos position) {
69:         if (!(level.getServer() instanceof GameTestServer)) {
70:             throw new IllegalStateException("Save-guard fixture cleanup requires the actual GameTestServer");
71:         }
72:         state(level).restoreFixture(position.toLong());
73:     }
74: 
75:     private static final class Provider implements ICapabilityProvider {
76:         private final ChunkSaveDenials state = new ChunkSaveDenials();
77:         private final LazyOptional<ChunkSaveDenials> capability = LazyOptional.of(() -> state);
78:         private void invalidate() { state.close(); capability.invalidate(); }
79:         @Override @NotNull public <T> LazyOptional<T> getCapability(@NotNull Capability<T> requested, @Nullable Direction side) {
80:             return CAPABILITY.orEmpty(requested, capability);
81:         }
82:     }
83: 
84:     private GuardedChunkSaves() { }
85: }

