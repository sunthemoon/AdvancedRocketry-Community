65:             throw new IllegalArgumentException("Unsupported pump root");
66:         }
67:         UUID owner = root.contains("owner") ? root.getUUID("owner") : null;
68:         CompoundTag payload = root.getCompound("fluid");
69:         FluidStack fluid = FluidStack.EMPTY;
70:         if (!payload.isEmpty()) {
71:             if (!payload.getAllKeys().containsAll(Set.of("FluidName", "Amount"))
72:                     || !FLUID_KEYS.containsAll(payload.getAllKeys()) || !payload.contains("FluidName", Tag.TAG_STRING)
