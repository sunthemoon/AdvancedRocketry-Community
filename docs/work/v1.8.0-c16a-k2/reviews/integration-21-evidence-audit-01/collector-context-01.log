import hashlib
import json
import os
import shutil
import sys
import xml.etree.ElementTree as ET
import zipfile
from pathlib import Path

here = Path(__file__).parent
root = Path('D:/GitHub/AdvancedRocketry-Community')
def io(path):
    return path if os.name != 'nt' or str(path).startswith('\\\\?\\') else Path('\\\\?\\' + str(path.absolute()))
def record(raw):
    return {'bytes': len(raw), 'sha256': hashlib.sha256(raw).hexdigest()}
def write(name, value):
    target = here / name
    assert not target.exists(), target
    target.write_text(json.dumps(value, indent=2) + '\n')
def exact(manifest):
    for name, expected in manifest.items():
        assert record((root / name).read_bytes()) == expected, name
action = sys.argv[1]
if action == 'precheck':
    manifest = json.loads((here / 'integration-18-predata-source-manifest.json').read_bytes())
    exact(manifest)
    write('menu-integration-18-postimage-check.json', {'source_files': len(manifest), 'exact': True,
        'Root_source_applied': True, 'Java_or_runtime_admission': False})
    print('Exact code predata source:', len(manifest))
elif action == 'postdata':
    assert (here / 'integration-data18-01.exit').read_text().strip() == '0'
    before = json.loads((here / 'integration-18-predata-source-manifest.json').read_bytes())
    changes = {}
    labels = ('generic', 'recipe_missing', 'recipe_changed', 'recipe_tags_invalid',
              'signature_migration_pending', 'signature_migration_unproven', 'retained_plan_invalid')
    allowed = {f'src/generated/v1.8/resources/assets/advancedrocketrycommunity_v180/lang/{language}.json'
               for language in ('en_us', 'zh_cn')}
    after = {}
    with zipfile.ZipFile(here / 'integration-artifacts-15/advancedrocketry-community-1.20.1-1.8.0-dev.jar') as baseline:
        for name, expected in before.items():
            raw = (root / name).read_bytes()
            value = record(raw)
            after[name] = value
            if name in allowed:
                old = baseline.read(name.removeprefix('src/generated/v1.8/resources/'))
                assert record(old) == expected, name
                old_values = json.loads(old)
                new_values = json.loads(raw)
                assert all(new_values.get(key) == old_value for key, old_value in old_values.items())
                assert set(new_values) - set(old_values) == {
                    'status.advancedrocketrycommunity.machine_recipe.' + label for label in labels}
                assert all(isinstance(new_values['status.advancedrocketrycommunity.machine_recipe.' + label], str)
                           and new_values['status.advancedrocketrycommunity.machine_recipe.' + label]
                           for label in labels)
                changes[name] = {'before': expected, 'after': value, 'added_labels': len(labels)}
            else:
                assert value == expected, name
    assert len(after) == 2986 and len(changes) == 2
    write('integration-18-source-manifest.json', dict(sorted(after.items())))
    write('integration-18-data-change.json', {'changes': changes,
        'manifest_sha256': hashlib.sha256((here / 'integration-18-source-manifest.json').read_bytes()).hexdigest(),
        'other_source_inputs_unchanged': len(after) - len(changes)})
    print(json.dumps({'source_files': len(after), 'changed_generated_languages': len(changes)}))
elif action == 'tests':
    assert (here / 'integration-build-data-18.exit').read_text().strip() == '0'
    target = here / 'integration-build-data-18-xml/test'
    assert not target.exists()
    target.mkdir(parents=True)
    files = sorted((root / 'build/test-results/test').glob('*.xml'))
    assert files
    declared = {key: 0 for key in ('tests', 'failures', 'errors', 'skipped')}
    actual = dict(declared)
    records = {}
    for path in files:
        raw = io(path).read_bytes()
        destination = target / path.name
        io(destination).write_bytes(raw)
        assert io(destination).read_bytes() == raw
        suite = ET.fromstring(raw)
        cases = suite.findall('testcase')
        for key in declared:
            declared[key] += int(suite.get(key, '0'))
        actual['tests'] += len(cases)
        for tag, key in (('failure', 'failures'), ('error', 'errors'), ('skipped', 'skipped')):
            actual[key] += sum(len(case.findall(tag)) for case in cases)
        records[path.name] = record(raw)
    assert declared == actual
    assert not any(actual[key] for key in ('failures', 'errors', 'skipped'))
    write('integration-build-data-18-junit.json', {'suites': len(files), 'declared': declared,
        'testcase_elements': actual, 'xml': records})
    print(json.dumps({'suites': len(files), **actual}))
elif action == 'artifacts':
    assert (here / 'integration-build-data-18.exit').read_text().strip() == '0'
    exact(json.loads((here / 'integration-18-source-manifest.json').read_bytes()))
    destination = here / 'integration-artifacts-18'
    assert not destination.exists()
    destination.mkdir()
    resources = root / 'src/generated/v1.8/resources'
    generated = sorted(path for path in resources.rglob('*') if path.is_file()
                       and '.cache' not in path.relative_to(resources).parts)
    records = []
    for source in sorted((root / 'build/libs').glob('*.jar')):
        with zipfile.ZipFile(source) as archive:
            names = archive.namelist()
            assert archive.testzip() is None and len(names) == len(set(names))
            api = source.name.endswith('-api.jar')
            suffix = '.java' if source.name.endswith('-sources.jar') else '.class'
            if not api:
                for resource in generated:
                    assert archive.read(resource.relative_to(resources).as_posix()) == resource.read_bytes()
                for leaf in ('machine/menu/MachineMenuNetwork', 'machine/menu/MachineMenuOpening',
                             'machine/menu/RecipeMenuReason', 'gametest/RecipeMenuGameTests'):
                    assert 'io/github/sunthemoon/advancedrocketrycommunity/' + leaf + suffix in names
            records.append({'name': source.name, **record(source.read_bytes()), 'entries': len(names),
                'generated_files_compared': 0 if api else len(generated)})
        shutil.copyfile(source, destination / source.name)
    assert len(records) == 3
    write('integration-artifacts-18.json', records)
    print(json.dumps(records))
elif action == 'gt':
    import re
    assert (here / 'integration-gametest-09.exit').read_text().strip() == '0'
    source = root / 'build/gametest/logs/latest.log'
    raw = source.read_bytes()
    counts = re.findall(r'All (\d+) required tests passed', raw.decode('utf-8'))
    gradle = (here / 'integration-gametest-09.log').read_bytes()
    assert len(counts) == 1
    assert re.findall(r'All (\d+) required tests passed', gradle.decode('utf-8')) == counts
    target = here / 'integration-gametest-09-latest.log'
    assert not target.exists()
    target.write_bytes(raw)
    exact(json.loads((here / 'integration-18-source-manifest.json').read_bytes()))
    write('integration-gametest-09-counts.json', {'required_passed': int(counts[0]), 'exit': 0,
        'minecraft_log': record(raw), 'gradle_log': record(gradle),
        'logger_ERROR_lines': len(re.findall(r'/ERROR\]', raw.decode('utf-8'))), 'clean_log_claimed': False})
    print('Required GameTests passed:', counts[0])
else:
    raise ValueError(action)

