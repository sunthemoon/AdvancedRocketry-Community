387                 && machine.menuInventory().getStackInSlot(ElectrolyzerBlockEntity.SLOT_OXYGEN).getCount() == 1,
388                 "Electrolyzer outputs were not produced exactly once");
389         helper.assertTrue(machine.waterAmount() == 0 && machine.energyStored() == energy, "Electrolyzer resources changed incorrectly");
390         helper.assertFalse(machine.saveWithoutMetadata().contains(ProcessJournalPersistence.ROOT), "Electrolyzer retained its journal");
391     }
