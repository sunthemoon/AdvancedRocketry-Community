SOURCE src/main/java/io/github/sunthemoon/advancedrocketrycommunity/gametest/RecipeMenuChannelGameTests.java 8452cbb77f9b4a34ab0cb8c3535b9b9e0f60814a450699cab488d72b71397af5
22     public static void installedMenuChannelAdvertisesAndRejectsIncompatiblePeerVersions(GameTestHelper helper) {
23         try {
24             ResourceLocation menuId = ModIdentity.id("machine_menu");
25             Map<ResourceLocation, String> advertised = advertised();
26             helper.assertTrue("1".equals(advertised.get(menuId)),
27                     "Common setup must install the required menu channel before this observation");
28             for (String direction : new String[] {"validateClientChannels", "validateServerChannels"}) {
29                 helper.assertTrue(rejected(direction, advertised).isEmpty(),
30                         "Matching installed channel versions must be accepted by " + direction);
31                 Map<ResourceLocation, String> missing = new HashMap<>(advertised);
32                 missing.remove(menuId);
33                 Map<ResourceLocation, String> missingRejected = rejected(direction, missing);
34                 helper.assertTrue(missingRejected.size() == 1 && missingRejected.containsKey(menuId),
35                         "Only the omitted menu channel must be rejected by " + direction);
36                 for (String version : new String[] {"", "0", "2", "01", "1 ",
37                         NetworkRegistry.ABSENT.version(), NetworkRegistry.ACCEPTVANILLA}) {
38                     Map<ResourceLocation, String> incompatible = new HashMap<>(advertised);
39                     incompatible.put(menuId, version);
40                     Map<ResourceLocation, String> refused = rejected(direction, incompatible);
41                     helper.assertTrue(refused.size() == 1 && refused.containsKey(menuId),
42                             "Only the incompatible menu channel must be rejected by " + direction);
43                     helper.assertTrue(version.equals(refused.get(menuId)),
44                             "The rejection must report the supplied peer version without rewriting it");
45                 }
46             }
47             helper.assertTrue(advertised.equals(advertised()),
48                     "Read-only channel validation must not change installed advertisements");
49             helper.succeed();
50         } catch (ReflectiveOperationException exception) {
51             throw new IllegalStateException("Pinned Forge channel observation is unavailable", exception);
52         }
53     }
54 
55     @SuppressWarnings("unchecked")
56     private static Map<ResourceLocation, String> advertised() throws ReflectiveOperationException {
57         Method method = NetworkRegistry.class.getDeclaredMethod("buildChannelVersions");
58         method.setAccessible(true);
59         return (Map<ResourceLocation, String>) method.invoke(null);
60     }
61 
62     @SuppressWarnings("unchecked")
63     private static Map<ResourceLocation, String> rejected(String direction, Map<ResourceLocation, String> incoming)
64             throws ReflectiveOperationException {
65         Method method = NetworkRegistry.class.getDeclaredMethod(direction, Map.class);
66         method.setAccessible(true);
67         return (Map<ResourceLocation, String>) method.invoke(null, incoming);
68     }
69 }

