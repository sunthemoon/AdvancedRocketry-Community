===== evidence/checks21.py =====
import datetime
import hashlib
import json
import subprocess
import sys
from pathlib import Path

here = Path(__file__).parent
root = Path('D:/GitHub/AdvancedRocketry-Community')
python = [sys.executable, '-B']
mode = sys.argv[1]
if mode == 'scoped':
    jobs = [
        ('ledger-strict-21', python + ['scripts/validate_v180_content_ledger.py', '--require-accepted'], 0),
        ('ledger-closure-21', python + ['scripts/validate_v180_content_ledger.py', '--closure'], 1),
        ('common-client-21', python + ['scripts/check_client_imports.py'], 0),
        ('focused-python-21', python + ['-m', 'unittest', 'tests.test_run_v180_pump_smoke', 'tests.test_run_v180_tank_smoke', 'tests.test_run_v180_signature_smoke', '-v'], 0),
        ('artifact-21', python + ['scripts/validate_build_artifact.py', str(here / 'integration-artifacts-21/advancedrocketry-community-1.20.1-1.8.0-dev.jar'), '--expected-version', '1.20.1-1.8.0-dev'], 0),
        ('git-diff-check-21', ['git', 'diff', '--check'], 0),
        ('git-diff-exit-21', ['git', 'diff', '--exit-code'], 1),
    ]
elif mode == 'full':
    for origin, target, old, new in (
        ('validate_repository_boundary15.py', 'validate_repository_boundary21.py', 'repository-boundary-15.json', 'repository-boundary-21.json'),
        ('verify_current_links15.py', 'verify_current_links17.py', 'markdown-links-15.json', 'markdown-links-17.json'),
    ):
        source = (here / origin).read_text()
        assert source.count(old) == 1
        path = here / target
        assert not path.exists()
        path.write_text(source.replace(old, new))
    jobs = [
        ('markdown-links-17', python + [str(here / 'verify_current_links17.py')], 0),
        ('repository-boundary-21', python + [str(here / 'validate_repository_boundary21.py')], 0),
        ('planning-21', python + ['scripts/validate_v1plus_planning.py'], 0),
        ('provenance-21', python + ['scripts/validate_bootstrap_provenance.py', '--require-approved-review'], 0),
        ('machine-resources-21', python + ['scripts/validate_v120_machine_resources.py'], 0),
    ]
else:
    raise ValueError(mode)
records = []
for name, command, documented in jobs:
    log = here / (name + '.log')
    command_path = here / (name + '.command.json')
    assert not log.exists() and not command_path.exists()
    start = datetime.datetime.now(datetime.timezone.utc)
    command_path.write_text(json.dumps({'command': command, 'cwd': str(root), 'started_utc': start.isoformat()}, indent=2) + '\n')
    with log.open('xb') as stream:
        result = subprocess.run(command, cwd=root, stdout=stream, stderr=subprocess.STDOUT)
    end = datetime.datetime.now(datetime.timezone.utc)
    (here / (name + '.exit')).write_text(str(result.returncode) + '\n')
    row = {'name': name, 'exit': result.returncode, 'documented_exit': documented,
           'documented_failure_not_pass': documented != 0,
           'elapsed_seconds': (end - start).total_seconds(), 'finished_utc': end.isoformat(),
           'log_sha256': hashlib.sha256(log.read_bytes()).hexdigest()}
    records.append(row)
    print(json.dumps(row), flush=True)
destination = here / ('checks-21-' + mode + '.json')
assert not destination.exists()
destination.write_text(json.dumps({'jobs': records, 'release_gate_claimed': False,
    'old_failures_not_relabelled': True}, indent=2) + '\n')
sys.exit(int(any(r['exit'] != r['documented_exit'] for r in records)))


===== evidence/validate_repository_boundary21.py =====
"""Run unchanged repository checks with the owner's foreign-directory boundary.



Only the Git untracked inventory receives a literal directory exclusion.

Tracked inputs, trusted Git environment, byte/count/time budgets, validation

assertions and result reporting are unchanged. This is an explicit bounded

wrapper run, not an unmodified direct-command or release-Gate claim.

"""

import hashlib

import json

import sys

from pathlib import Path



root = Path('D:/GitHub/AdvancedRocketry-Community')

here = Path(__file__).parent

sys.path.insert(0, str(root))

from scripts import validate_repository as validator



prefix = 'AdvancedRocketry-Community-v1plus-Development-Docs/'

original = validator._bounded_git_stdout

calls = []



def inventory(command, **kwargs):

    args = list(command)

    excluded = 'ls-files' in args and '--others' in args

    if excluded:

        args.append('--exclude=/' + prefix)

    result = original(args, **kwargs)

    if 'ls-files' in args:

        assert not any(name.decode('utf-8').startswith(prefix)

                       for name in result.split(b'\0') if name)

    calls.append({'command': args, 'foreign_directory_excluded': excluded,

                  'stdout_bytes': len(result),

                  'stdout_sha256': hashlib.sha256(result).hexdigest()})

    return result



validator._bounded_git_stdout = inventory

sys.argv = [str(root / 'scripts/validate_repository.py'), '--require-approved-identity']

code = validator.main()

receipt = here / 'repository-boundary-21.json'

assert not receipt.exists()

receipt.write_text(json.dumps({'validator_sha256': hashlib.sha256(

    (root / 'scripts/validate_repository.py').read_bytes()).hexdigest(),

    'exit': code, 'calls': calls, 'release_gate_claimed': False}, indent=2) + '\n')

sys.exit(code)



