{
  "schema": 1,
  "scope": "W159 protected placement and installed player-file proof",
  "info": {
    "guard": "ARCE_REJOIN_GUARD player={uuid} state={state} reason={reason}",
    "placed": "ARCE_REJOIN_PLACED player={uuid} release={uuid} generation={uuid} target={target}",
    "verified": "ARCE_REJOIN_VERIFIED player={uuid} release={uuid} generation={uuid}"
  },
  "warn": {
    "player_limit": "ARCE_REJOIN_PLAYER_LIMIT player={uuid} kind={kind} size={size} ceiling={ceiling}"
  },
  "guard_states": ["guard", "disconnect", "waiting", "capacity", "conflict", "unsafe", "tickets", "io", "oversized", "dead"],
  "target_values": ["PAD", "OVERWORLD_SPAWN"],
  "limit_kinds": ["OVERSIZED", "DEPTH"],
  "integration_heavy_1_only_counts": {"guard": 2, "placed": 1, "verified": 1, "player_limit": 0},
  "all_other_warning_counts": 0,
  "native_shutdown_clean": {
    "scope": "Exactly once in H1/H2 C20 seed; zero in every other run.",
    "holds": ["H1", "H2"],
    "cut": "C20",
    "mode": "seed",
    "count": 1,
    "otherwise_count": 0,
    "thread": "Server thread",
    "level": "INFO",
    "loggers": ["advancedrocketrycommunity/", "io.github.sunthemoon.advancedrocketrycommunity.AdvancedRocketryCommunity/"],
    "message": "ARCE_W159_SHUTDOWN_CLEAN threads=0 tickets=0"
  },
  "native_c9": {
    "scope": "Only H1/H2 C9 seed: one marked nonempty backup directory; no allowances on either restart.",
    "loggers": ["minecraft/Util", "net.minecraft.Util/"],
    "messages": {
      "delete": "Failed to delete",
      "sequence": "Failed to execute delete old {path}",
      "retry": "Failed to create backup {path}, retrying ([0-9])/10",
      "abort": "Failed to create backup {path}, aborting, progress might be lost"
    },
    "counts": {"delete": 10, "sequence": 10, "retry_0": 1, "retry_1": 1, "retry_2": 1, "retry_3": 1,
      "retry_4": 1, "retry_5": 1, "retry_6": 1, "retry_7": 1, "retry_8": 1, "retry_9": 1, "abort": 1}
  }
}
